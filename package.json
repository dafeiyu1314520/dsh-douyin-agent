{
  "name": "dsh-douyin-agent",
  "version": "1.4.5",
  "type": "module",
  "description": "DSH 原生抖音工具：有限自主观看、抽帧故事板与弹幕、人格与兴趣记忆、自动问候与私信回复、观看日报",
  "license": "MIT",
  "author": {
    "name": "dafeiyu1314520",
    "url": "https://github.com/dafeiyu1314520"
  },
  "contributors": [
    {
      "name": "LockyBee",
      "url": "https://github.com/LockyBee"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dafeiyu1314520/dsh-douyin-agent.git"
  },
  "homepage": "https://github.com/dafeiyu1314520/dsh-douyin-agent#readme",
  "bugs": {
    "url": "https://github.com/dafeiyu1314520/dsh-douyin-agent/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "douyin",
    "browser-automation",
    "persona",
    "local-memory"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dependencies": {
    "@playwright/cli": "0.1.22",
    "@playwright/mcp": "0.0.83"
  },
  "files": [
    "api-agent.mjs",
    "autonomous-comments.mjs",
    "autonomous-replies.mjs",
    "autonomous-share.mjs",
    "autonomous-watch.mjs",
    "browser-host.mjs",
    "browser-launcher.mjs",
    "capture-session.mjs",
    "chat-agent.mjs",
    "chat-browser.mjs",
    "chat-message.mjs",
    "chat-service.mjs",
    "client.js",
    "comment-browser.mjs",
    "core.mjs",
    "daily-report.mjs",
    "danmaku.mjs",
    "diary-writer.mjs",
    "dsh-plugin.mjs",
    "frame-composite.mjs",
    "frame-grab.mjs",
    "media-cleanup.mjs",
    "memory.mjs",
    "mention-picker.mjs",
    "message-tracker.mjs",
    "native-model-settings.mjs",
    "native-persona-context.mjs",
    "native-settings.mjs",
    "native-spark-greeting.mjs",
    "native-watch-decision.mjs",
    "outbound-send.mjs",
    "persona-memory.mjs",
    "playwright-runtime.mjs",
    "public-comment-agent.mjs",
    "qq-sync.mjs",
    "relay-settings.mjs",
    "reply-agent.mjs",
    "reply-service.mjs",
    "runtime-paths.mjs",
    "spark-agent.mjs",
    "spark-service.mjs",
    "toast.mjs",
    "tool-definitions.mjs",
    "video-forward.mjs",
    "video-limits.mjs",
    "watch-mode.mjs",
    "cordis.bundle.yml",
    "media/index.mjs",
    "media/key-store.mjs",
    "media/local_whisper.py",
    "media/mimo_bridge.py",
    "media/setup_local.py",
    "media/requirements.txt",
    "media/README.md",
    "media/PROVENANCE.json",
    "media/vendor/mimo/driver/mimo_driver.py",
    "media/vendor/mimo/LICENSE",
    "media/vendor/voice/lib/providers.js",
    "media/vendor/voice/lib/provider-http.js",
    "media/vendor/voice/LICENSE",
    "media/vendor/minimax/lib/index.js",
    "media/vendor/minimax/LICENSE",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "skill/SKILL.md",
    "docs/"
  ],
  "exports": {
    ".": "./dsh-plugin.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.bundle.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "os": [
    "win32"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "start": "node app.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:native": "node --test verification/dsh-plugin.test.mjs verification/native-launch-command.test.mjs verification/native-settings.test.mjs tests/native-watch.test.mjs tests/native-spark.test.mjs tests/native-client.test.mjs",
    "test:browser": "node verification/browser-live.mjs"
  }
}
